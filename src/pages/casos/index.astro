---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const caseStudies = await getCollection('casos-estudio');

const otherProjectIds = ['intelligent-agenda-automation', 'portafolio-web'];
let mainCases = caseStudies.filter(study => !otherProjectIds.includes(study.id));
let otherCases = caseStudies.filter(study => otherProjectIds.includes(study.id));

mainCases.sort((a, b) => {
  if (a.id === 'fiscalis') return -1;
  if (b.id === 'fiscalis') return 1;
  return 0;
});
---

<Layout title="Casos de Estudio | Pablo Valdés" description="Explora casos de estudio y proyectos de software reales desarrollados por Pablo Valdés. Análisis de problemas, arquitectura e implementación.">
  <Header />
  
  <main class="pt-20">
    <!-- Header Section -->
    <section class="py-section-gap px-gutter max-w-container-max mx-auto relative overflow-hidden animate-on-scroll">
      <div class="relative z-10 text-center space-y-4">
        <span class="font-code-sm text-code-sm text-primary bg-primary/10 px-3 py-1 rounded-full uppercase tracking-wider">
          Portafolio de Proyectos
        </span>
        <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface max-w-3xl mx-auto">
          Casos de Estudio
        </h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto leading-relaxed">
          Proyectos reales, desarrollados de forma independiente junto a negocios que no podían costear un desarrollo tradicional, a cambio de la oportunidad de construir experiencia práctica real antes de mi primer empleo formal. La tecnología fue la herramienta; el objetivo, resolver problemas de negocio concretos.
        </p>
      </div>
    </section>

    <!-- Case Studies Grid -->
    <section class="py-section-gap px-gutter max-w-container-max mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {mainCases.map((study, index) => (
          <a href={`/casos/${study.id}`} class="block group animate-on-scroll" style={`transition-delay: ${index * 50}ms;`}>
            <article class="glass-card p-8 rounded-xl flex flex-col h-full transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 relative overflow-hidden">
              <div class="flex justify-between items-start mb-6">
                <span class="font-code-sm text-xs px-3 py-1 rounded-full bg-primary/10 text-primary border border-primary/20">
                  {study.data.status}
                </span>
                <span class="font-code-sm text-sm text-on-surface-variant bg-surface-container px-2 py-1 rounded">
                  {study.data.year}
                </span>
              </div>
              
              <h2 class="font-headline-md text-headline-md text-on-surface mb-2 group-hover:text-primary transition-colors">
                {study.data.title}
              </h2>

              {study.data.url && (
                <div class="mb-4">
                  <span class="inline-flex items-center gap-1.5 font-code-sm text-xs text-primary bg-primary/10 border border-primary/20 px-2.5 py-1 rounded-md">
                    <span class="material-symbols-outlined notranslate text-[14px]" translate="no">public</span>
                    {study.data.url.replace(/^https?:\/\//, '')}
                  </span>
                </div>
              )}
              
              <p class="font-body-md text-body-md text-on-surface-variant mb-8 flex-grow">
                {study.data.description}
              </p>
              
              <div class="mt-auto pt-6 border-t border-outline-variant/10">
                <div class="flex flex-wrap gap-2">
                  {study.data.tags?.slice(0, 3).map(tag => (
                    <span class="font-code-sm text-xs bg-surface-container-high text-on-surface-variant px-2 py-1 rounded-md border border-outline-variant/20">
                      {tag}
                    </span>
                  ))}
                  {study.data.tags && study.data.tags.length > 3 && (
                    <span class="font-code-sm text-xs bg-surface-container-high text-on-surface-variant px-2 py-1 rounded-md border border-outline-variant/20">
                      +{study.data.tags.length - 3}
                    </span>
                  )}
                </div>
              </div>
            </article>
          </a>
        ))}
      </div>

      {otherCases.length > 0 && (
        <div class="mt-24">
          <h2 class="font-headline-md text-headline-md text-on-surface mb-8 text-center animate-on-scroll">Otros proyectos</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {otherCases.map((study, index) => (
              <a href={`/casos/${study.id}`} class="block group animate-on-scroll" style={`transition-delay: ${index * 50}ms;`}>
                <article class="glass-card p-8 rounded-xl flex flex-col h-full transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 relative overflow-hidden">
                  <div class="flex justify-between items-start mb-6">
                    <span class="font-code-sm text-xs px-3 py-1 rounded-full bg-primary/10 text-primary border border-primary/20">
                      {study.data.status}
                    </span>
                    <span class="font-code-sm text-sm text-on-surface-variant bg-surface-container px-2 py-1 rounded">
                      {study.data.year}
                    </span>
                  </div>
                  
                  <h2 class="font-headline-md text-headline-md text-on-surface mb-2 group-hover:text-primary transition-colors">
                    {study.data.title}
                  </h2>

                  {study.data.url && (
                    <div class="mb-4">
                      <span class="inline-flex items-center gap-1.5 font-code-sm text-xs text-primary bg-primary/10 border border-primary/20 px-2.5 py-1 rounded-md">
                        <span class="material-symbols-outlined notranslate text-[14px]" translate="no">public</span>
                        {study.data.url.replace(/^https?:\/\//, '')}
                      </span>
                    </div>
                  )}
                  
                  <p class="font-body-md text-body-md text-on-surface-variant mb-8 flex-grow">
                    {study.data.description}
                  </p>
                  
                  <div class="mt-auto pt-6 border-t border-outline-variant/10">
                    <div class="flex flex-wrap gap-2">
                      {study.data.tags?.slice(0, 3).map(tag => (
                        <span class="font-code-sm text-xs bg-surface-container-high text-on-surface-variant px-2 py-1 rounded-md border border-outline-variant/20">
                          {tag}
                        </span>
                      ))}
                      {study.data.tags && study.data.tags.length > 3 && (
                        <span class="font-code-sm text-xs bg-surface-container-high text-on-surface-variant px-2 py-1 rounded-md border border-outline-variant/20">
                          +{study.data.tags.length - 3}
                        </span>
                      )}
                    </div>
                  </div>
                </article>
              </a>
            ))}
          </div>
        </div>
      )}
    </section>
  </main>
  
  <Footer />
</Layout>
