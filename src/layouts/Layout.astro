---
import '../styles/global.css';
import CyberBackground from '../components/CyberBackground.astro';
import CustomCursor from '../components/CustomCursor.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "Portafolio profesional de Pablo Valdés, Desarrollador Backend Junior (Python, FastAPI, PostgreSQL) y Analista Programador. Enfoque analítico, arquitectura de software limpia y buenas prácticas de ingeniería.",
  image = "/og-image.png" 
} = Astro.props;

const pageTitle = title.includes('Pablo Valdés') ? title : `${title} | Pablo Valdés`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || Astro.url);
const ogImageUrl = new URL(image, Astro.site || Astro.url);
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <meta name="google-site-verification" content="TK4Ee5u5B10s5oS6m74gxg1jf6Vw6A_vLyg2dki1iwI" />
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <meta name="author" content="Pablo Valdés" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />
    
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=JetBrains+Mono:wght@400&family=Geist:wght@600;700&display=swap" rel="stylesheet"/>
    
    <!-- SEO & Robots -->
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- JSON-LD Structured Data for Developer Portfolio / ProfilePage -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      "mainEntity": {
        "@type": "Person",
        "name": "Pablo Valdés",
        "jobTitle": "Backend Developer Junior",
        "image": new URL(image, Astro.url).toString(),
        "description": description,
        "url": Astro.site ? Astro.site.toString() : Astro.url.origin,
        "sameAs": [
          "https://www.linkedin.com/in/pablo-vald%C3%A9s-7a4445430/",
          "https://github.com/naxo16"
        ],
        "knowsAbout": [
          "Python",
          "FastAPI",
          "PostgreSQL",
          "Astro",
          "TypeScript",
          "Docker",
          "Ingeniería de Software",
          "Arquitectura Limpia",
          "Principios SOLID"
        ],
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Cauquenes",
          "addressRegion": "Maule",
          "addressCountry": "CL"
        }
      }
    })} />
  </head>
  <body class="font-body-md text-body-md overflow-x-hidden antialiased selection:bg-[#80182a] selection:text-[#f2cf6b] cursor-default">
    <CyberBackground />
    <CustomCursor />
    <slot />
    
    <script>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      // Run on initial load and view transitions if used
      const initAnimations = () => {
        document.querySelectorAll('.animate-on-scroll').forEach((el) => {
          observer.observe(el);
        });
      };
      
      initAnimations();
    </script>
    
    <!-- GTranslate Settings -->
    <script>
      window.gtranslateSettings = {
        "default_language": "es",
        "languages": ["es", "en"],
        "wrapper_selector": ".gtranslate_wrapper",
        "alt_flags": {"en": "usa"}
      };
    </script>
    <script src="https://cdn.gtranslate.net/widgets/latest/dropdown.js" defer></script>
  </body>
</html>
